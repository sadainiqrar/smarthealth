# Copy to .env and fill in real values. .env is gitignored; this file is not.
# The test stack uses .env.test, which IS committed (ports and local credentials only).

# --- Application ---
SMARTHEALTH_ENVIRONMENT=local
SMARTHEALTH_RESOURCE_PREFIX=
SMARTHEALTH_LLM_MODE=fixture
# Root log level. Raising verbosity during an incident is an env change and a restart,
# not a redeploy. Applies to the application's own loggers and to uvicorn's, which are
# routed into the same JSON handler.
SMARTHEALTH_LOG_LEVEL=INFO

# --- PostgreSQL (system of record) ---
SMARTHEALTH_POSTGRES_HOST=localhost
SMARTHEALTH_POSTGRES_PORT=5432
SMARTHEALTH_POSTGRES_USER=smarthealth
SMARTHEALTH_POSTGRES_PASSWORD=change-me
SMARTHEALTH_POSTGRES_DB=smarthealth

# --- MongoDB (audit trail) ---
SMARTHEALTH_MONGO_HOST=localhost
SMARTHEALTH_MONGO_PORT=27017
SMARTHEALTH_MONGO_DB=smarthealth

# --- Redis ---
SMARTHEALTH_REDIS_HOST=localhost
SMARTHEALTH_REDIS_PORT=6379
SMARTHEALTH_REDIS_DB=0

# --- Temporal (durable workflows) ---
SMARTHEALTH_TEMPORAL_HOST=localhost
SMARTHEALTH_TEMPORAL_PORT=7233
SMARTHEALTH_TEMPORAL_NAMESPACE=default

# --- Auth ---
# Ed25519 private key, PEM. Unset = the committed development key (refused when
# SMARTHEALTH_ENVIRONMENT=production). Generate: python -m app.cli generate-signing-key
# SMARTHEALTH_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----
"
SMARTHEALTH_ACCESS_TOKEN_MINUTES=10
SMARTHEALTH_SESSION_HOURS=12
SMARTHEALTH_LOGIN_MAX_FAILURES=5
SMARTHEALTH_LOGIN_IP_MAX_FAILURES=50
SMARTHEALTH_LOGIN_WINDOW_MINUTES=15
SMARTHEALTH_BOOKING_RATE_LIMIT_PER_MINUTE=10

# --- Infrastructure ports (docker-compose.infra.yml) ---
POSTGRES_PORT=5432
POSTGRES_USER=smarthealth
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smarthealth
MONGO_PORT=27017
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=smarthealth
RABBITMQ_PASSWORD=change-me
KAFKA_PORT=9092
SCHEMA_REGISTRY_PORT=8081
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080

# --- Part B (populate in week 4) ---
# LLM_PROVIDER=
# LLM_API_KEY=

# --- The assistant's model (Part B; services/assistant/assistant_service/llm.py) ---
# Put real values in .env (git-ignored), never in a tracked file. With no key the assistant
# still runs every guided flow and answers from the clinic's documents.
# Switching provider is these three lines; an empty model uses the provider's default
# (groq: openai/gpt-oss-120b, anthropic: claude-haiku-5-5, openai: gpt-5-mini).
ASSISTANT_LLM_PROVIDER=groq
ASSISTANT_LLM_MODEL=
ASSISTANT_LLM_API_KEY=
# auto (default) = live when a key is set; or off | fixture | record | live
# ASSISTANT_LLM_MODE=auto
