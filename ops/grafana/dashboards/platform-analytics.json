{
  "uid": "smarthealth-platform-analytics",
  "title": "SmartHealth — Platform analytics",
  "description": "The five Part A metrics (PART-A-FR-5), read from the analytics_daily rollup as a read-only role. Business numbers, not Prometheus counters.",
  "tags": [
    "smarthealth",
    "part-a"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Patients",
      "description": "The register's size now.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analytics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT count(*) AS value FROM patients",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analytics"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Appointments booked",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analytics"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT coalesce(sum(booked), 0) AS value FROM analytics_daily WHERE day BETWEEN $__timeFrom()::date AND $__timeTo()::date",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analytics"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Completed visits",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analytics"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT coalesce(sum(completed), 0) AS value FROM analytics_daily WHERE day BETWEEN $__timeFrom()::date AND $__timeTo()::date",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analytics"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Cancellation rate",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analytics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT sum(cancelled)::float / nullif(sum(booked), 0) AS value FROM analytics_daily WHERE day BETWEEN $__timeFrom()::date AND $__timeTo()::date",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analytics"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Average wait",
      "description": "seen_at - checked_in_at, over visits that were seen (PRD D-3).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analytics"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT sum(wait_seconds_sum)::float / nullif(sum(wait_count), 0) AS value FROM analytics_daily WHERE day BETWEEN $__timeFrom()::date AND $__timeTo()::date",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analytics"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "No-shows",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analytics"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT coalesce(sum(no_show), 0) AS value FROM analytics_daily WHERE day BETWEEN $__timeFrom()::date AND $__timeTo()::date",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analytics"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Appointments booked over time",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analytics"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 16,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT day::timestamptz AS time, sum(booked) AS booked, sum(cancelled) AS cancelled, sum(completed) AS completed FROM analytics_daily WHERE day BETWEEN $__timeFrom()::date AND $__timeTo()::date GROUP BY day ORDER BY day",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analytics"
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Average wait per day",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "analytics"
      },
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT day::timestamptz AS time, sum(wait_seconds_sum)::float / nullif(sum(wait_count), 0) AS wait FROM analytics_daily WHERE day BETWEEN $__timeFrom()::date AND $__timeTo()::date GROUP BY day ORDER BY day",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "analytics"
          }
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
