# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Environment / secrets
.env
.env.*
!.env.example
*.pem

# Local data volumes
data/
*.db
*.sqlite3

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Word temp files
~$*.docx

# Claude Code local overrides
.claude/settings.local.json

# Test run artifacts (never checked-in state)
tests/reports/*
!tests/reports/.gitkeep

# The test stack's port/credential config is committed on purpose — it holds no
# secrets, and both the harness and a reviewer need it to boot the same stack.
!.env.test
