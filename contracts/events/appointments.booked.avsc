{
  "type": "record",
  "name": "AppointmentBooked",
  "namespace": "smarthealth.events.v1",
  "doc": "An appointment was confirmed: the booking workflow's final, paired write committed.",
  "fields": [
    {
      "name": "event_id",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "uuid7; the idempotency key every consumer dedupes on"
    },
    {
      "name": "event_type",
      "type": {
        "type": "string"
      },
      "doc": "the topic's logical name, e.g. appointments.cancelled"
    },
    {
      "name": "schema_version",
      "type": "int"
    },
    {
      "name": "occurred_at",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "when the change committed (the outbox row's insert time)"
    },
    {
      "name": "producer",
      "type": {
        "type": "string"
      },
      "doc": "part-a, knowledge or assistant"
    },
    {
      "name": "subject_id",
      "type": {
        "type": "string"
      },
      "doc": "the entity the event is about; also the Kafka message key"
    },
    {
      "name": "payload",
      "type": {
        "type": "record",
        "name": "AppointmentBookedPayload",
        "fields": [
          {
            "name": "appointment_id",
            "type": {
              "type": "string",
              "logicalType": "uuid"
            }
          },
          {
            "name": "patient_id",
            "type": {
              "type": "string",
              "logicalType": "uuid"
            }
          },
          {
            "name": "provider_id",
            "type": {
              "type": "string",
              "logicalType": "uuid"
            }
          },
          {
            "name": "clinic_id",
            "type": {
              "type": "string",
              "logicalType": "uuid"
            }
          },
          {
            "name": "department_id",
            "type": [
              "null",
              {
                "type": "string",
                "logicalType": "uuid"
              }
            ],
            "default": null
          },
          {
            "name": "slot_id",
            "type": {
              "type": "string",
              "logicalType": "uuid"
            }
          },
          {
            "name": "starts_at",
            "type": {
              "type": "long",
              "logicalType": "timestamp-millis"
            }
          },
          {
            "name": "ends_at",
            "type": {
              "type": "long",
              "logicalType": "timestamp-millis"
            }
          },
          {
            "name": "rescheduled_from_id",
            "type": [
              "null",
              {
                "type": "string",
                "logicalType": "uuid"
              }
            ],
            "default": null
          },
          {
            "name": "origin",
            "type": [
              "null",
              {
                "type": "string"
              }
            ],
            "default": null
          },
          {
            "name": "conversation_ref",
            "type": [
              "null",
              {
                "type": "string"
              }
            ],
            "default": null
          }
        ]
      }
    }
  ]
}
