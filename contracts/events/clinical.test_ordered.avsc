{
  "type": "record",
  "name": "TestOrdered",
  "namespace": "smarthealth.events.v1",
  "doc": "A clinician ordered a test. Which test is not said: the order is read from Part A.",
  "fields": [
    {
      "name": "event_id",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "uuid7; the idempotency key every consumer dedupes on"
    },
    {
      "name": "event_type",
      "type": {
        "type": "string"
      },
      "doc": "the topic's logical name, e.g. appointments.cancelled"
    },
    {
      "name": "schema_version",
      "type": "int"
    },
    {
      "name": "occurred_at",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "when the change committed (the outbox row's insert time)"
    },
    {
      "name": "producer",
      "type": {
        "type": "string"
      },
      "doc": "part-a, knowledge or assistant"
    },
    {
      "name": "subject_id",
      "type": {
        "type": "string"
      },
      "doc": "the entity the event is about; also the Kafka message key"
    },
    {
      "name": "payload",
      "type": {
        "type": "record",
        "name": "TestOrderedPayload",
        "fields": [
          {
            "name": "order_id",
            "type": {
              "type": "string",
              "logicalType": "uuid"
            }
          },
          {
            "name": "note_id",
            "type": {
              "type": "string",
              "logicalType": "uuid"
            }
          },
          {
            "name": "patient_id",
            "type": {
              "type": "string",
              "logicalType": "uuid"
            }
          },
          {
            "name": "provider_id",
            "type": {
              "type": "string",
              "logicalType": "uuid"
            }
          },
          {
            "name": "urgency",
            "type": {
              "type": "string"
            }
          }
        ]
      }
    }
  ]
}
